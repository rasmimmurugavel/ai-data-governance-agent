# Copy to .env and fill in. Never commit the real .env file.

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- PostgreSQL target (the database being audited) ---
# Prefer a dedicated READ-ONLY role for this app. See db/README.md
# "Provisioning a read-only audit role" for the SQL to create one.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=dq_dev
PGUSER=dq_audit_reader
# Local dev only: matches db/seed/00_provision_role.sql
PGPASSWORD=devpassword
PGSSLMODE=prefer

# Optional: full DSN overrides the discrete PG* vars above if set
# DATABASE_URL=postgresql://dq_audit_reader:devpassword@127.0.0.1:5432/dq_dev?sslmode=prefer

# --- Governance controls ---
# Comma-separated list of schemas the agent is allowed to touch.
# Empty = all schemas visible to PGUSER (still read-only, still audited).
DQ_ALLOWED_SCHEMAS=eval_nulls_and_dupes,eval_orphaned_fk,eval_pii_column,eval_stale_data
# Hard cap on rows returned by any single query tool call.
DQ_MAX_ROWS=500
# Hard cap on statement execution time (ms) - enforced via SET statement_timeout.
DQ_STATEMENT_TIMEOUT_MS=10000
# Where the append-only audit log (every tool call + args + row count) is written.
DQ_AUDIT_LOG_PATH=./audit_log/audit.jsonl
